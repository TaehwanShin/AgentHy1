{
  "agentName": "taehwan-pc",
  "fileEncoding": "utf-8",
  "projects": {
    "general": "C:/Workspaces",
    "ZSD_ORDER": "C:/Workspaces/RAP_Project/ZSD_ORDER"
  },
  "static": {
    "apiBase": "<deploy.js 가 출력한 apiBase>",
    "appName": "claude-bridge",
    "appUrl": "<deploy.js 가 출력한 appUrl>",
    "token": "<게시 API 토큰>",
    "publishDiff": true
  },
  "orchestrator": {
    "sessionName": "Orchestrator",
    "pollIntervalSec": 5,
    "maxWaitHours": 23
  },
  "claude": {
    "command": "claude",
    "permissionMode": "acceptEdits",
    "allowedTools": ["Read", "Edit", "Write", "Glob", "Grep", "Bash(git status:*)", "Bash(git diff:*)"],
    "model": null,
    "maxBudgetUsd": 2,
    "timeoutMin": 30
  }
}
